---
const { ariaLabel = 'Social links' } = Astro.props;
---
<div class="social-links" role="navigation" aria-label={ariaLabel}>
    <div>
        <img src="/icons/github.svg" alt="GitHub" />
        <a href="https://github.com/milanhundersmarck" target="_blank" rel="noopener noreferrer">github</a>
    </div>

    <div>
        <img src="/icons/email.svg" alt="Email" />
        <a href="mailto:milanhundersmarck01@hotmail.nl">email</a>
    </div>

    <div>
        <img src="/icons/linkedin.svg" alt="LinkedIn" />
        <a href="https://www.linkedin.com/in/milan-hundersmarck-57a53a200/" target="_blank" rel="noopener noreferrer">linkedin</a>
    </div>
</div>

<style>
    .social-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
    }

    .social-links > div {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        white-space: nowrap;
    }

    .social-links img {
        width: 16px;
        height: 16px;
        display: block;
    }

    .social-links a {
        color: var(--text-primary);
        font-size: 13px;
    }

    .social-links a:hover {
        color: var(--text-muted);
    }
</style>
