<!-- title, subtitle, tags, url, image -->
---
const { title, subtitle, tags, urltype, url, image } = Astro.props;
---

<div class="card">
    <div class="titlerow">
        <div class="titleblock">
            <div class="title-link-row">
                <h3>{title}</h3>
                <div class="link">
                    <img src="/icons/arrow-angle.svg" alt="Email" />
                    <a href={url} target="_blank" rel="noopener noreferrer">{urltype}</a>
                </div>
            </div>
            <p class="subtitle">{subtitle}</p>
        </div>
        <div class="tags">
            {tags.map((tag) => (
                <p>{tag}</p>
            ))}
        </div>
    </div>
</div>

<script>
    const card = document.querySelector(".card");
    const link = card?.querySelector(".link a") as HTMLAnchorElement;
    card?.addEventListener("click", () => {
        if (link?.href) {
            window.open(link.href, '_blank')?.focus();
        }
    });
</script>

<style>
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
        transition: border-color 0.2s ease-in-out;
    }

    .card:hover {
        border-color: var(--text-faint);
    }

    .titlerow {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .titleblock {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .title-link-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .title-link-row h3,
    .subtitle,
    .title-link-row a,
    .tags p {
        margin: 0;
    }

    .title-link-row a {
        font-size: 12px;
        color: var(--text-faint);
    }

    h3 {
        font-size: 16px;
        font-weight: 500;
        color: var(--text-primary);
    }

    .subtitle {
        font-size: 14px;
        color: var(--text-muted);
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tags p {
        font-size: 12px;
        color: var(--text-primary);
        border: 1px solid var(--border);
        padding: 3px 8px 3px 8px;
        border-radius: 99px;
        margin-top: 10px;
    }

    .link {
        display: flex;
        align-items: center;
        gap: 0.25rem;

        img {
            width: 12px;
            height: 12px;
            display: block;
        }
    }
</style>
